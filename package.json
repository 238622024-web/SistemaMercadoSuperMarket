{
  "name": "sistema-mercado-supermarket",
  "version": "1.0.0",
  "description": "Sistema de supermercado com Node.js e Supabase",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently -k -n API,Vite \"npm:dev:server\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "supabase",
    "node",
    "mercado",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
